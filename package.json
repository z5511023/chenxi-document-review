    "start": "bash ./scripts/start.sh",
    "ts-check": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.95.3",
    "call-bind-apply-helpers": "^1.0.2",
    "coze-coding-dev-sdk": "^0.7.20",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.2",
    "eslint": "^9",
    "jszip": "^3.10.1",
    "only-allow": "^1.2.2",
    "pdfjs-dist": "4.4.168",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8",
    "vite": "^7.2.4"
  },
  "packageManager": "pnpm@9.0.0",
